{
    "$schema": "../kdeconnect.schema.json",
    "KPlugin": {
        "Authors": [
            {
                "Name": "KDE Connect contributors"
            }
        ],
        "Description": "Show the phone's screen, or one of its apps, in a window on this computer",
        "EnabledByDefault": true,
        "Icon": "smartphone",
        "License": "GPL",
        "Name": "Mirror Phone"
    },
    "X-KdeConnect-OutgoingPacketType": [
        "kdeconnect.mirrorphone.response",
        "kdeconnect.mirrorphone.adb",
        "kdeconnect.mirrorphone.status",
        "kdeconnect.mirrorphone.icons.request"
    ],
    "X-KdeConnect-SupportedPacketType": [
        "kdeconnect.mirrorphone.request",
        "kdeconnect.mirrorphone.adb.status",
        "kdeconnect.mirrorphone.lock",
        "kdeconnect.mirrorphone.icon"
    ]
}
